# Copy to tv-home.env (not versioned) and fill in your TV's details.
# IP address of the LG TV on the local network (give it a fixed lease on the router)
TVHOME_TV_IP=192.168.1.50
# MAC address of the TV, for Wake-on-LAN (optional; needs "Turn on via Wi-Fi" on the TV)
TVHOME_TV_MAC=aa:bb:cc:dd:ee:ff
